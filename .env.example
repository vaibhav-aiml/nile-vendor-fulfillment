# ==============================================================================
# NILE — Vendor Partnership & Fulfillment Service Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production, testing)
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL with PostGIS)
# ------------------------------------------------------------------------------
# Synchronous DB URL (used by Alembic and Celery sync tasks)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nile_fulfillment

# Asynchronous DB URL (optional, for async SQLAlchemy sessions if used)
# DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@localhost:5432/nile_fulfillment

# ------------------------------------------------------------------------------
# Redis & Background Workers (Celery & Event Pub/Sub)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Redis Pub/Sub channel for fulfillment events (e.g. rejection, SLA breach, alternate needed)
REDIS_EVENTS_CHANNEL=nile:fulfillment:events

# ------------------------------------------------------------------------------
# Business Logic & SLA Configuration
# ------------------------------------------------------------------------------
# Maximum hours allowed for non-partnered manual outreach before escalating to ALTERNATE_NEEDED
OUTREACH_SLA_HOURS=24

# ------------------------------------------------------------------------------
# Ops Dashboard Authentication (Phase 1 Static Token Check)
# ------------------------------------------------------------------------------
# Shared token for internal Ops dashboard staff (passed via `X-Ops-Token` header)
OPS_AUTH_SECRET=your_ops_secret_token_here
